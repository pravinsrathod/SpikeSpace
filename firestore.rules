rules_version = '2';

// ============================================================
// ProManager — Firestore Security Rules
// ============================================================
// Data model:
//   /tournaments/{tournamentId}
//     managerId:      uid of the creator (immutable after creation)
//     status:         'REGISTRATION' | 'ACTIVE' | 'COMPLETED'
//
//     /teams/{teamId}
//       captainId:    uid of the user who registered the team
//       status:       'PENDING' | 'APPROVED'
//
//     /matches/{matchId}
//       (created/managed exclusively by the tournament manager)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // Helper functions
    // ----------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Fetches the parent tournament document to check managerId.
    // Used inside subcollection rules.
    function getTournament(coll, tid) {
      let docPath = '/databases/(default)/documents/' + coll + '/' + tid;
      return get(path(docPath));
    }

    function isTournamentManager(coll, tournamentId) {
      return isAuthenticated()
        && getTournament(coll, tournamentId).data.managerId == request.auth.uid;
    }

    // Validates that only allowed fields changed (no extra keys snuck in).
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ----------------------------------------------------------
    // /{coll}/{tournamentId} (covers tournaments and badminton_tournaments)
    // ----------------------------------------------------------
    match /{coll}/{tournamentId} {
      allow read, write: if false; // Default fail, overrides inside


      // Public: anyone can browse the tournament list and view details.
      allow read: if (coll == 'tournaments' || coll == 'badminton_tournaments');

      // Authenticated users can create a tournament.
      // Constraints: they must be the manager, status must start as REGISTRATION.
      allow create: if (coll == 'tournaments' || coll == 'badminton_tournaments') 
        && isAuthenticated()
        && request.resource.data.managerId == request.auth.uid
        && request.resource.data.status == 'REGISTRATION';

      // Only the manager can update the tournament.
      // managerId is immutable after creation — prevents ownership hijacking.
      allow update: if (coll == 'tournaments' || coll == 'badminton_tournaments') 
        && isUser(resource.data.managerId)
        && request.resource.data.managerId == resource.data.managerId;

      // Only the manager can delete the tournament.
      allow delete: if (coll == 'tournaments' || coll == 'badminton_tournaments') 
        && isUser(resource.data.managerId);

      // ----------------------------------------------------------
      // /{coll}/{tournamentId}/teams/{teamId}
      // ----------------------------------------------------------
      match /teams/{teamId} {

        // Public: anyone can see the team list.
        allow read: if (coll == 'tournaments' || coll == 'badminton_tournaments');

        // Any authenticated user can register a team.
        // Rules:
        //   - captainId must be their own uid (no impersonation)
        //   - Regular users can only register as PENDING
        //   - Managers can directly register as APPROVED (manual add flow)
        allow create: if (coll == 'tournaments' || coll == 'badminton_tournaments')
          && isAuthenticated()
          && request.resource.data.captainId == request.auth.uid
          && (
            request.resource.data.status == 'PENDING'
            || (request.resource.data.status == 'APPROVED' && isTournamentManager(coll, tournamentId))
          );

        // Two separate update paths:
        //   1. Captain: can edit name, players, colorHex — cannot touch status or captainId
        //   2. Manager: can edit anything (approve/reject, correct data, etc.)
        allow update: if (coll == 'tournaments' || coll == 'badminton_tournaments')
          && (
            (isUser(resource.data.captainId) && onlyChanged(['name', 'players', 'colorHex']))
            || isTournamentManager(coll, tournamentId)
          );

        // Captain can remove their own team; manager can remove any team.
        allow delete: if (coll == 'tournaments' || coll == 'badminton_tournaments')
          && (isUser(resource.data.captainId) || isTournamentManager(coll, tournamentId));
      }

      // ----------------------------------------------------------
      // /{coll}/{tournamentId}/matches/{matchId}
      // ----------------------------------------------------------
      match /matches/{matchId} {

        // Public: anyone can view live scores and fixtures.
        allow read: if (coll == 'tournaments' || coll == 'badminton_tournaments');

        // Only the tournament manager can create matches (on tournament start).
        allow create: if (coll == 'tournaments' || coll == 'badminton_tournaments')
          && isTournamentManager(coll, tournamentId);

        // Only the tournament manager can update match scores/status.
        // updatedAt is always expected to change, so no field restriction here.
        allow update: if (coll == 'tournaments' || coll == 'badminton_tournaments')
          && isTournamentManager(coll, tournamentId);

        // Only the tournament manager can delete matches (reset draws).
        allow delete: if (coll == 'tournaments' || coll == 'badminton_tournaments')
          && isTournamentManager(coll, tournamentId);
      }
    }
  }
}
